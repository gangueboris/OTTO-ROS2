<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="camera_joint" type="fixed">
        <parent link="body_link"/>
        <child link="camera_link"/>
        <origin xyz="0.037 0.0 0.03" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="camera_link">
        <xacro:inertia_box m="0.005" x="0.005" y="0.005" z="0.003"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.005 0.005 0.003"/>
            </geometry>
            <material name="otto_black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.005 0.005 0.003"/>
            </geometry>
        </collision>
    </link>

</robot>