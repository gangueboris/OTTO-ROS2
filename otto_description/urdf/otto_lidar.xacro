<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="lidar_joint" type="fixed">
        <parent link="body_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.0 0.0 0.035" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="lidar_link">
        <xacro:inertia_cylinder m="0.01" r="0.017795" h="0.0125"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.017795" length="0.0125"/>
            </geometry>
            <material name="otto_black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.017795" length="0.0125"/>
            </geometry>
        </collision>
    </link>


    <!-- =========== Gazebo tag ========== -->
    <gazebo reference="lidar_link">
        <sensor name="lidar_sensor" type="gpu_lidar">   <!-- Ray: scanning sensor (lidar)-->
            <always_on>true</always_on>
            <update_rate>10</update_rate> 
            <topic>/scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>     
                        <resolution>1.0</resolution>
                        <min_angle>-3.14159</min_angle> 
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>  
                    <max>8.0</max>   
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev> 
                </noise>
            </ray>

            <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
                <render_engine>ogre2</render_engine>
            </plugin>
        </sensor>
    </gazebo>

</robot>