<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- GAZEBO PLUGINS / TAGS -->
  <!-- Color setting -->
    <gazebo reference="body_link">
      <visual>
        <material>
          <ambient>0.18 0.52 0.80 1.0</ambient>       <!-- Lighting: t dictates what the object looks like when it is in the shadows -->
          <diffuse>0.18 0.52 0.80 1.0</diffuse>       <!-- Color : object reflects when a direct light source (like the sun or a spotlight) hits it.-->
        </material>
      </visual>
    </gazebo>

    <gazebo reference="left_leg_link">
      <visual>
        <material>
          <ambient>0.18 0.52 0.80 1.0</ambient>
          <diffuse>0.18 0.52 0.80 1.0</diffuse>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="right_leg_link">
      <visual>
        <material>
          <ambient>0.18 0.52 0.80 1.0</ambient>
          <diffuse>0.18 0.52 0.80 1.0</diffuse>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="left_foot_link">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
      <visual>
        <material>
          <ambient>0.65 0.65 0.65 1.0</ambient>
          <diffuse>0.65 0.65 0.65 1.0</diffuse>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="right_foot_link">
      <mu1>0.9</mu1>                              <!-- Friction/gripping on the floor. -->
      <mu2>0.9</mu2>
      <visual>
        <material>
          <ambient>0.65 0.65 0.65 1.0</ambient>
          <diffuse>0.65 0.65 0.65 1.0</diffuse>
        </material>
      </visual>
    </gazebo>

    <!-- Gazebo's Plugins -->
    <gazebo>
      <!-- gz-sim-joint-state-publisher-system -->
      <!-- JointStatePublisher: Measures the joints in Gazebo frequently -> sends to /joint_states via the bridge -> 
      ROS 2 uses Forward Kinematics to calculate the robot's current physical posture.
       -->
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>                   <!-- specification of the topic to which gazebo will communicate with ROS2 -->
        <joint_name>left_hip_joint</joint_name>
        <joint_name>left_foot_joint</joint_name>
        <joint_name>right_hip_joint</joint_name>
        <joint_name>right_foot_joint</joint_name>
      </plugin>

      <!-- gz_ros2_control -->
      <!-- gz_ros2_control listen to the logic (Inverse Kinematics) from ROS2 and translate it to the simulation to move the robot. -->
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find otto_description)/config/controllers.yaml</parameters>    <!-- Load the yaml file to gazebo. -->
      </plugin>
    </gazebo>


    <!-- ROS2_control Specifications -->
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="left_hip_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_foot_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_hip_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_foot_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </robot>
  