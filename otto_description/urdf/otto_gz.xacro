<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- GAZEBO PLUGINS -->
  <!-- Color setting -->
    <gazebo reference="body_link">
      <visual>
        <material>
          <ambient>0.18 0.52 0.80 1.0</ambient>       <!-- Lighting: dictates what the object looks like when it is in the shadows -->
          <diffuse>0.18 0.52 0.80 1.0</diffuse>       <!-- Color : object reflects when a direct light source (like the sun or a spotlight) hits it.-->
        </material>
      </visual>
    </gazebo>

    <gazebo reference="left_leg_link">
      <visual>
        <material>
          <ambient>0.18 0.52 0.80 1.0</ambient>
          <diffuse>0.18 0.52 0.80 1.0</diffuse>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="right_leg_link">
      <visual>
        <material>
          <ambient>0.18 0.52 0.80 1.0</ambient>
          <diffuse>0.18 0.52 0.80 1.0</diffuse>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="left_foot_link">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
      <visual>
        <material>
          <ambient>0.65 0.65 0.65 1.0</ambient>
          <diffuse>0.65 0.65 0.65 1.0</diffuse>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="right_foot_link">
      <mu1>0.9</mu1>                              <!-- Friction/gripping on the floor. -->
      <mu2>0.9</mu2>
      <visual>
        <material>
          <ambient>0.65 0.65 0.65 1.0</ambient>
          <diffuse>0.65 0.65 0.65 1.0</diffuse>
        </material>
      </visual>
    </gazebo>

    <!--<gazebo reference="right_back_support_link">
        <mu1>0</mu1>
        <mu2>0</mu2>
    </gazebo>
     <gazebo reference="right_front_support_link">
        <mu1>0</mu1>
        <mu2>0</mu2>
    </gazebo>
     <gazebo reference="left_back_support_link">
        <mu1>0</mu1>
        <mu2>0</mu2>
    </gazebo>
     <gazebo reference="left_front_support_link">
        <mu1>0</mu1>
        <mu2>0</mu2>
    </gazebo>-->




    <!-- Gazebo's Plugins -->
    <gazebo>
      <!-- gz-sim-joint-state-publisher-system -->
      <!-- JointStatePublisher: Measures the joints in Gazebo frequently -> sends to /joint_states via the bridge -> 
      ROS 2 uses Forward Kinematics to calculate the robot's current physical posture.
       -->
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>                   <!-- specification of the topic to which gazebo will communicate with ROS2 -->
        <joint_name>left_hip_joint</joint_name>
        <joint_name>left_foot_joint</joint_name>
        <joint_name>right_hip_joint</joint_name>
        <joint_name>right_foot_joint</joint_name>
      </plugin>

      <!-- Differential Drive Plugin -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

        <!-- Wheels configuration  -->
        <left_joint>left_foot_joint</left_joint>
        <right_joint>right_foot_joint</right_joint>
        <wheel_separations>0.045</wheel_separations>
        <wheel_radius>0.03</wheel_radius>

        <!-- output: Control and Odometry (position) -->
        <odom_publish_frequency>50</odom_publish_frequency>

        <!-- Input -->
        <topic>cmd_vel</topic>

        <!-- Topics Gazebo will publish the data to -->
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      
      <!-- Coordinate frames for RViz and Navigation -->
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      </plugin>
    </gazebo>


  </robot>
  