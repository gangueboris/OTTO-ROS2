<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="otto">

  <!-- ── Include utilities ── -->
  <xacro:include filename="otto_materials.xacro" />
  <xacro:include filename="otto_ros2_control.xacro" />
  <xacro:include filename="otto_lidar.xacro" />
  <xacro:include filename="otto_camera.xacro" />
  <xacro:include filename="otto_display.xacro" />

  <!--==== PHYSICAL PARAMETERS ====-->

  <!-- Body / head combined box -->
  <xacro:property name="body_x"    value="0.075"/>   <!-- width  -->
  <xacro:property name="body_y"    value="0.060"/>   <!-- depth  -->
  <xacro:property name="body_z"    value="0.065"/>   <!-- height -->
  <xacro:property name="body_mass" value="0.07"/>

  <!-- Leg segment -->
  <xacro:property name="leg_x"    value="0.020"/>
  <xacro:property name="leg_y"    value="0.015"/>
  <xacro:property name="leg_z"    value="0.018"/>
  <xacro:property name="leg_mass" value="0.025"/>

  <!-- Bar segment -->
  <xacro:property name="bar_x"    value="0.08"/>
  <xacro:property name="bar_y"    value="0.002"/>
  <xacro:property name="bar_z"    value="0.0015"/>
  <xacro:property name="bar_mass" value="0.005"/>
  
  <!-- Bar support segment -->
  <xacro:property name="support_x"    value="0.009"/>
  <xacro:property name="support_y"    value="0.014"/>
  <xacro:property name="support_z"    value="0.0015"/>
  <xacro:property name="support_mass" value="0.001"/>

  <!-- Foot (flat disc) -->
  <xacro:property name="foot_r"    value="0.030"/>
  <xacro:property name="foot_h"    value="0.005"/>
  <xacro:property name="foot_mass" value="0.020"/>

  <!-- Servo joint limits (±360° realistic for Otto walk) -->
  <xacro:property name="servo_limit" value="3.14"/>   <!-- rad, ~360° -->
  <xacro:property name="servo_vel"   value="3.14"/>     <!-- rad/s     -->
  <xacro:property name="servo_eff"   value="0.5"/>      <!-- N·m       -->

  <!-- Lateral offset: distance from body centre to each leg -->
  <xacro:property name="leg_offset_y" value="0.025"/>

  <!-- Vertical offsets -->
  <!-- body_link origin is at the body's geometric centre -->
  <xacro:property name="body_z_from_base" value="${body_z/2.0}"/>
  <!-- hip joint is at bottom face of body, laterally offset -->
  <xacro:property name="hip_z_in_body"    value="${-body_z/2.0}"/>
  <!-- foot joint is at the bottom of the leg -->
  <xacro:property name="foot_z_in_leg"    value="${-leg_z/2.0}"/>

  <!--=== BASE LINK  (world / floor anchor, mass-less) ===-->
  <link name="base_link"/>

  <!--=== BODY / HEAD LINK ===-->

  <link name="body_link">
    <xacro:inertia_box m="${body_mass/2}" x="${body_x}" y="${body_y}" z="${-body_z/2}"/>

    <!-- Torso + head box (grey top, blue sides) — single visual block -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_x} ${body_y} ${body_z}"/>
      </geometry>
      <material name="otto_grey"/>
    </visual>

    <!-- Blue mid-band visual -->
    <visual>
      <origin xyz="0 0 ${-body_z*0.1}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_x} ${body_y} ${body_z*0.40}"/>
      </geometry>
      <material name="otto_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_x} ${body_y} ${body_z}"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_body" type="fixed">
    <parent link="base_link"/>
    <child  link="body_link"/>
    <origin xyz="0 0 ${body_z_from_base}" rpy="0 0 0"/>
  </joint>

  <!-- Base footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0.10" rpy="0 0 0"/> 
  </joint>

  <!--=== LEFT LEG ASSEMBLY ===-->

  <!-- Servo block (cosmetic, fixed to body) -->
  <xacro:servo_block
    prefix="left_hip"
    parent_link="body_link"
    xyz="0 ${leg_offset_y} ${hip_z_in_body}"
    rpy="0 0 0"/>

  <!-- Hip revolute joint — rotates about X (swing leg fore/aft) -->
  <joint name="left_hip_joint" type="revolute">
    <parent link="left_hip_servo"/>
    <child  link="left_leg_link"/>
    <origin xyz="0 0 ${-leg_z/2.0}" rpy="0 0 0"/>
    <axis   xyz="1 0 0"/>
    <limit  lower="${-servo_limit}" upper="${servo_limit}"
            effort="${servo_eff}"   velocity="${servo_vel}"/>
    <xacro:servo_dynamics/>
  </joint>

  <link name="left_leg_link">
    <xacro:inertia_box m="${leg_mass}" x="${leg_x}" y="${leg_y}" z="${leg_z}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_x} ${leg_y} ${leg_z}"/>
      </geometry>
      <material name="otto_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_x} ${leg_y} ${leg_z}"/>
      </geometry>
    </collision>
  </link>
  <!-- Balance bar -->
  <joint name="left_bar_joint" type="fixed">
    <origin xyz="0.0 ${-leg_y/2} ${-leg_z/2 + bar_z}" rpy="0.0 0.0 0.0"/>
    <parent link="left_leg_link"/>
    <child link="left_bar_link"/>
  </joint>

  <!-- Left front support -->
  <joint name="left_front_support_joint" type="fixed">
    <origin xyz="${bar_x/2 - support_x/2} ${-support_y/2} 0" rpy="0.0 0.0 0.0"/> 
    <parent link="left_bar_link"/>
    <child link="left_front_support_link"/>
  </joint>

   <link name="left_front_support_link">
    <xacro:inertia_box m="${support_mass}" x="${support_x}" y="${support_y}" z="${support_z}"/>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${support_x} ${support_y} ${support_z}"/>
      </geometry>
      <material name="otto_blue"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${support_x} ${support_y} ${support_z}"/> 
      </geometry>
    </collision>
  </link>

  <!--Left back support -->
  <joint name="left_back_support_joint" type="fixed">
    <origin xyz="${-bar_x/2 + support_x/2} ${-support_y/2} 0" rpy="0.0 0.0 0.0"/> 
    <parent link="left_bar_link"/>
    <child link="left_back_support_link"/>
  </joint>

  <link name="left_back_support_link">
    <xacro:inertia_box m="${support_mass}" x="${support_x}" y="${support_y}" z="${support_z}"/>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${support_x} ${support_y} ${support_z}"/>
      </geometry>
      <material name="otto_blue"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${support_x} ${support_y} ${support_z}"/> 
      </geometry>
    </collision>
  </link>

  <link name="left_bar_link">
    <xacro:inertia_box m="${bar_mass}" x="${bar_x}" y="${bar_y}" z="${bar_z}"/>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${bar_x} ${bar_y} ${bar_z}"/>
      </geometry>
      <material name="otto_blue"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${bar_x} ${bar_y} ${bar_z}"/>
      </geometry>
    </collision>
  </link>

  <!-- Foot revolute joint — rotates about Z (tilt foot) -->
  <joint name="left_foot_joint" type="revolute">
    <parent link="left_leg_link"/>
    <child  link="left_foot_link"/>
    <origin xyz="0 0 ${foot_z_in_leg - foot_h/2.0}" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit  lower="${-servo_limit/2}" upper="${servo_limit/2}"
            effort="${servo_eff}"   velocity="${servo_vel}"/>
    <xacro:servo_dynamics/>
  </joint>

  <link name="left_foot_link">
    <xacro:inertia_cylinder m="${foot_mass}" r="${foot_r}" h="${foot_h}"/>
     <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${foot_r}" length="${foot_h}"/>
      </geometry>
      <material name="otto_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${foot_r}" length="${foot_h}"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="left_foot_link"/>
    <child  link="left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> <axis   xyz="0 0 -1"/> </joint>

 <link name="left_wheel_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${foot_r}" length="${foot_h}"/>
      </geometry>
    </collision>
  </link>

  <!-- RIGHT LEG ASSEMBLY  (mirror of left) -->

  <xacro:servo_block
    prefix="right_hip"
    parent_link="body_link"
    xyz="0 ${-leg_offset_y} ${hip_z_in_body}"
    rpy="0 0 0"/>

  <joint name="right_hip_joint" type="revolute">
    <parent link="right_hip_servo"/>
    <child  link="right_leg_link"/>
    <origin xyz="0 0 ${-leg_z/2.0}" rpy="0 0 0"/>
    <axis   xyz="1 0 0"/>
    <limit  lower="${-servo_limit}" upper="${servo_limit}"
            effort="${servo_eff}"   velocity="${servo_vel}"/>
    <xacro:servo_dynamics/>
  </joint>

  <link name="right_leg_link">
    <xacro:inertia_box m="${leg_mass}" x="${leg_x}" y="${leg_y}" z="${leg_z}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_x} ${leg_y} ${leg_z}"/>
      </geometry>
      <material name="otto_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${leg_x} ${leg_y} ${leg_z}"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_bar_joint" type="fixed">
    <origin xyz="0.0 ${leg_y/2} ${-leg_z/2 + bar_z}" rpy="0.0 0.0 0.0"/>
    <parent link="right_leg_link"/>
    <child link="right_bar_link"/>
  </joint>

  <link name="right_bar_link">
    <xacro:inertia_box m="${bar_mass}" x="${bar_x}" y="${bar_y}" z="${bar_z}"/>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${bar_x} ${bar_y} ${bar_z}"/>
      </geometry>
      <material name="otto_blue"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${bar_x} ${bar_y} ${bar_z}"/>
      </geometry>
    </collision>
  </link>

  <!-- Right front support -->
  <joint name="right_front_support_joint" type="fixed">
    <origin xyz="${bar_x/2 - support_x/2} ${support_y/2} 0" rpy="0.0 0.0 0.0"/> 
    <parent link="right_bar_link"/>
    <child link="right_front_support_link"/>
  </joint>

   <link name="right_front_support_link">
    <xacro:inertia_box m="${support_mass}" x="${support_x}" y="${support_y}" z="${support_z}"/>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${support_x} ${support_y} ${support_z}"/>
      </geometry>
      <material name="otto_blue"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${support_x} ${support_y} ${support_z}"/> 
      </geometry>
    </collision>
  </link>

  <!-- Right back support -->
  <joint name="right_back_support_joint" type="fixed">
    <origin xyz="${-bar_x/2 + support_x/2} ${support_y/2} 0" rpy="0.0 0.0 0.0"/> 
    <parent link="right_bar_link"/>
    <child link="right_back_support_link"/>
  </joint>

  <link name="right_back_support_link">
    <xacro:inertia_box m="${support_mass}" x="${support_x}" y="${support_y}" z="${support_z}"/>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${support_x} ${support_y} ${support_z}"/>
      </geometry>
      <material name="otto_blue"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${support_x} ${support_y} ${support_z}"/> 
      </geometry>
    </collision>
  </link>

  <joint name="right_foot_joint" type="revolute">
    <parent link="right_leg_link"/>
    <child  link="right_foot_link"/>
    <origin xyz="0 0 ${foot_z_in_leg - foot_h/2.0}" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit  lower="${-servo_limit/2}" upper="${servo_limit/2}"
            effort="${servo_eff}"   velocity="${servo_vel}"/>
    <xacro:servo_dynamics/>
  </joint>

  <link name="right_foot_link">
    <xacro:inertia_cylinder m="${foot_mass}" r="${foot_r}" h="${foot_h}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${foot_r}" length="${foot_h}"/>
      </geometry>
      <material name="otto_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${foot_r}" length="${foot_h}"/>
      </geometry>
    </collision>
  </link>

   <joint name="right_wheel_joint" type="continuous">
    <parent link="right_foot_link"/>
    <child  link="right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> <axis   xyz="0 0 1"/> </joint>

  <link name="right_wheel_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${foot_r}" length="${foot_h}"/>
      </geometry>
    </collision>
  </link>
</robot>
