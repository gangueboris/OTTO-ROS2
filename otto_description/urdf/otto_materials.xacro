<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="otto_materials">

  <!-- ============================================================
       OTTO ROBOT — Materials & Utility Components
       ============================================================ -->

  <!--==== COLORS / MATERIALS ====-->

  <material name="otto_blue">
    <color rgba="0.18 0.52 0.80 1.0"/>
  </material>

  <material name="otto_grey">
    <color rgba="0.65 0.65 0.65 1.0"/>
  </material>

  <material name="otto_dark_grey">
    <color rgba="0.30 0.30 0.30 1.0"/>
  </material>

  <material name="otto_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

  <material name="otto_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!--==== INERTIA MACROS  (solid primitives) ====-->

  <!-- Solid box  m [kg], x/y/z [m] (Dimension) -->
  <xacro:macro name="inertia_box" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y + z*z)/12.0}"
        ixy="0" ixz="0"
        iyy="${m*(x*x + z*z)/12.0}"
        iyz="0"
        izz="${m*(x*x + y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder  m [kg], r [m], h [m] -->
  <xacro:macro name="inertia_cylinder" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r + h*h)/12.0}"
        ixy="0" ixz="0"
        iyy="${m*(3*r*r + h*h)/12.0}"
        iyz="0"
        izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid sphere  m [kg], r [m] -->
  <xacro:macro name="inertia_sphere" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${2.0*m*r*r/5.0}"
        ixy="0" ixz="0"
        iyy="${2.0*m*r*r/5.0}"
        iyz="0"
        izz="${2.0*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- DEFAULT DYNAMICS MACRO: Apply to every revolute joint that drives a servo -->

  <xacro:macro name="servo_dynamics">
    <dynamics damping="0.01" friction="0.001"/>
  </xacro:macro>

  <!-- 
       SERVO GEOMETRY MACRO
       Represents a generic MG90 servo block
       parent_link : link to which the servo body is attached
       prefix      : unique name prefix  ("left_hip")
       xyz / rpy   : pose in parent frame
   -->

  <xacro:macro name="servo_block" params="prefix parent_link xyz rpy">

    <!-- Servo body -->
    <link name="${prefix}_servo">
      <xacro:inertia_box m="0.009" x="0.023" y="0.012" z="0.045"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.023 0.012 0.045"/>
        </geometry>
        <material name="otto_dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.023 0.012 0.045"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_servo_fixed" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="${prefix}_servo"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

  </xacro:macro>

  <!-- 
       ULTRASONIC SENSOR MACRO  (HC-SR04 style — the "eyes")
       parent_link : body/head link
       side        : "left" | "right"
       xyz / rpy   : pose in parent frame
     -->

  <xacro:macro name="ultrasonic_eye" params="side parent_link xyz rpy">

    <link name="${side}_eye">
      <xacro:inertia_cylinder m="0.003" r="0.008" h="0.012"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.008" length="0.012"/>
        </geometry>
        <material name="otto_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.008" length="0.012"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_eye_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="${side}_eye"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

  </xacro:macro>

</robot>
